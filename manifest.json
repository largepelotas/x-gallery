{
  "manifest_version": 3,
  "name": "X Gallery",
  "version": "0.1.0",
  "description": "A masonry gallery overlay for the x.com home timeline. Reads only what X already loads.",
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/largepelotas/x-gallery",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "src/parse.js",
        "src/store.js",
        "src/settings.js",
        "src/env.js",
        "src/native.js",
        "src/icons.js",
        "src/styles.js",
        "src/masonry.js",
        "src/cards.js",
        "src/drawer.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
